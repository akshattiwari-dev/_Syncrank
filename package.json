{
  "name": "syncrank",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend/*", "backend/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w frontend/web",
    "dev:api": "npm run dev -w backend/api",
    "dev:worker": "npm run dev -w backend/worker",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w backend/api && npm run typecheck -w backend/worker",
    "test": "npm run test -w packages/shared && npm run test -w backend/api",
    "lint": "eslint . --max-warnings=50",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "npm run prisma:generate -w packages/db",
    "prisma:migrate:dev": "npm run prisma:migrate:dev -w packages/db",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w packages/db",
    "prisma:seed": "npm run prisma:seed -w packages/db",
    "generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "build": "npm run generate && npm run build -w @syncrank/db -w @syncrank/shared && npm run build -w @syncrank/api -w @syncrank/worker -w @syncrank/web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.68.0"
  }
}